# Environment variables for Render or local deployment
# Copy this file to .env locally, or set the same keys in Render Environment Variables.

# Django security
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=quan-ly-khach-san-17l9.onrender.com

# Database
# Use the Render Postgres DATABASE_URL value if you add a managed database.
DATABASE_URL=postgres://username:password@hostname:port/dbname

# Cloudinary settings (optional if you use cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_CLOUDINARY=True
MEDIA_URL=https://res.cloudinary.com/your_cloud_name/

# Gemini AI API key (optional)
GEMINI_API_KEY=your_gemini_api_key
